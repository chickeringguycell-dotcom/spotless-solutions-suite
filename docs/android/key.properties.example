# Android Release Keystore Configuration Template
# Copy this file to 'key.properties' in the android/ directory.
# NEVER commit your real key.properties or .jks keystore to version control!

keyAlias=spotless_release_key
keyPassword=YOUR_KEY_PASSWORD_HERE
storeFile=../keystores/spotless_upload_keystore.jks
storePassword=YOUR_STORE_PASSWORD_HERE
