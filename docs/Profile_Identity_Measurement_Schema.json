{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile Identity Measurement Schema",
  "type": "object",
  "properties": {
    "profile_metrics": {
      "type": "object",
      "properties": {
        "forehead_slope": {"type": "number"},
        "nose_bridge_angle": {"type": "number"},
        "nose_projection": {"type": "number"},
        "nostril_position": {"type": "array", "items": {"type": "number"}},
        "upper_lip_projection": {"type": "number"},
        "lower_lip_projection": {"type": "number"},
        "chin_projection": {"type": "number"},
        "jaw_contour": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
        "mandibular_angle": {"type": "number"},
        "ear_position": {"type": "array", "items": {"type": "number"}},
        "ear_height": {"type": "number"},
        "hairline": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
        "neck_transition": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}}
      }
    }
  }
}
