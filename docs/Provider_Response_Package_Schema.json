{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Provider Response Package",
  "type": "object",
  "required": ["response_id", "request_id", "status"],
  "properties": {
    "response_id": { "type": "string" },
    "request_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILED_QUOTA",
        "FAILED_BILLING",
        "FAILED_TIMEOUT",
        "FAILED_CONTENT_POLICY",
        "ERROR"
      ]
    },
    "error_message": { "type": "string" },
    "generated_image_path": { "type": "string" },
    "provenance": { "$ref": "Provider_Provenance_Schema.json" }
  }
}
