{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "correction_id": { "type": "string" },
    "project_id": { "type": "string" },
    "subject_id": { "type": "string" },
    "candidate_asset_id": { "type": "string" },
    "failed_rule_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failed_region_masks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "affected_landmarks": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "affected_triangles": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "expected_measurements": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "actual_measurements": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "required_correction": { "type": "string" },
    "protected_region_masks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "immutable_feature_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provider_constraints": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "attempt_number": { "type": "integer" },
    "parent_asset_hash": { "type": "string" },
    "identity_specification_hash": { "type": "string" },
    "sentinelqc_report_hash": { "type": "string" }
  },
  "required": [
    "correction_id",
    "project_id",
    "subject_id",
    "candidate_asset_id",
    "failed_rule_ids",
    "required_correction",
    "attempt_number"
  ]
}